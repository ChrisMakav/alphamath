# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (Project Settings > API > service_role) — server-only, never expose to the client.
# Required for the Stripe webhook to update a user's profile without a logged-in session.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (AI tutor)
ANTHROPIC_API_KEY=

# Stripe — créer un compte sur https://dashboard.stripe.com, puis récupérer ces clés
# en mode test dans Developers > API keys / Developers > Webhooks.
# Le endpoint webhook doit écouter : checkout.session.completed, invoice.payment_succeeded,
# customer.subscription.updated, customer.subscription.deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — créer un compte sur https://resend.com pour l'envoi d'emails transactionnels.
# Sans domaine vérifié sur resend.com/domains, EMAIL_FROM doit rester onboarding@resend.dev
# (mode test, n'envoie qu'à l'adresse du compte Resend). Le domaine alphamath.xyz est
# vérifié en prod, d'où l'adresse ci-dessous.
RESEND_API_KEY=
EMAIL_FROM="AlphaMath <contact@alphamath.xyz>"

# URL publique du site, utilisée dans les emails transactionnels (lien vers le tableau de bord).
NEXT_PUBLIC_SITE_URL=http://localhost:3005
